        tween(loadingFill, { Size = UDim2.fromScale(1, 1) }, 0.72, Enum.EasingStyle.Quint)
    end
    function self:FinishLoading()
        if self._destroyed or self._loadingFinished then return false end
        self._loadingFinished = true
        local minDisplay = self.ReduceEffects and 0.12 or 0.72
        local remaining = math.max(0, minDisplay - (os.clock() - (self._loadingStartedAt or os.clock())))
        task.delay(remaining, function()
            if self._destroyed or not overlay.Parent then return end
            if self.ReduceEffects then
                overlay:Destroy()
                self._loadingOverlay = nil
                return
            end
            tween(loaderScale, { Scale = 0.94 }, 0.16, Enum.EasingStyle.Quad)
            tween(overlay, { BackgroundTransparency = 1 }, 0.28)
            tween(loaderCard, { BackgroundTransparency = 1 }, 0.22)
            fadeIcon(overlayIcon, 0.2)
            tween(loadingTitle, { TextTransparency = 1 }, 0.2)
            tween(loadingText, { TextTransparency = 1 }, 0.2)
            tween(loadingHint, { TextTransparency = 1 }, 0.2)
            tween(loadingBar, { BackgroundTransparency = 1 }, 0.2)
            tween(loadingFill, { BackgroundTransparency = 1 }, 0.2)
            task.delay(0.3, function()
                if overlay.Parent then overlay:Destroy() end
                if self._loadingOverlay == overlay then self._loadingOverlay = nil end
            end)
        end)
        return true
    end
    local loadingTimeout = math.clamp(tonumber(options.LoadingTimeout) or 1.5, 1, 30)
    task.delay(loadingTimeout, function()
        if not self._loadingFinished and not self._destroyed then self:FinishLoading() end
    end)

    if self.StartMinimized then
        self._open = false
        setAccentAnimations(self, false)
        self.Window.Visible = false
        self.RestoreButton.Visible = true
        self.RestoreButton.BackgroundTransparency = 0.08
        self.RestoreScale.Scale = 0.72
        local restoreStroke = self.RestoreButton:FindFirstChildOfClass("UIStroke")
        if restoreStroke then restoreStroke.Transparency = 0.04 end
        tween(self.RestoreScale, { Scale = 1 }, 0.34, Enum.EasingStyle.Back)
    end
    -- The sampler also feeds the floating restore card in minimized mode.
    setFpsSampling(self, true)

    function self:CreateTab(data) return self:AddTab(data) end
    function self:WindowToggle() return self:Toggle() end
    self._globalKey = globalKey
    return self
end

function AxelUI:RegisterIcon(name, source)
    if name and source then ICONS[string.lower(tostring(name))] = tostring(source) end
    return self
end

function AxelUI:RegisterIcons(map)
    for name, source in pairs(map or {}) do self:RegisterIcon(name, source) end
    return self
end

AxelUI.Version = 8.27
AxelUI.BuildId = "8.27.0-old-window-cleanup"

function AxelUI.CreateWindow(first, second)
    return AxelUI.new(second or first)
end

return AxelUI
end

-- Axel Hub / Project Slayers 2 UI adapter.
-- The original feature callbacks and loops remain in the source script.
-- This bridge implements only the old UI calls that the source actually uses.
local function createAxelCompat(AxelUI)
    local interface = { Options = {}, Flags = {}, AttackTargets = setmetatable({}, { __mode = "k" }) }
    local activeWindow
    local players = game:GetService("Players")
    local runService = game:GetService("RunService")
    local startedAt = os.clock()

    local function copyText(value)
        local copier = setclipboard or toclipboard
        if type(copier) ~= "function" then return false end
        local ok, result = pcall(copier, tostring(value or ""))
        return ok and result ~= false
    end

    local function elapsedText(seconds)
        local total = math.max(0, math.floor(tonumber(seconds) or 0))
        return string.format("%02d:%02d:%02d", math.floor(total / 3600),
            math.floor(total / 60) % 60, total % 60)
    end

    local function pingText(player)
        local ok, seconds = pcall(function() return player:GetNetworkPing() end)
        if ok and type(seconds) == "number" then
            return tostring(math.max(0, math.floor(seconds * 1000 + 0.5))) .. " ms"
        end
        return "-- ms"
    end

    local function executorName()
        local scopes = {}
        pcall(function()
            if type(getgenv) == "function" then
                local shared = getgenv()
                if type(shared) == "table" then table.insert(scopes, shared) end
            end
        end)
        pcall(function()
            if type(getfenv) == "function" then
                local scriptEnvironment = getfenv()
                if type(scriptEnvironment) == "table" then table.insert(scopes, scriptEnvironment) end
            end
        end)
        table.insert(scopes, _G)
        for _, scope in ipairs(scopes) do
            for _, key in ipairs({ "identifyexecutor", "getexecutorname", "identify_executor" }) do
                local detect = scope[key]
                if type(detect) == "function" then
                    local ok, name, version = pcall(detect)
                    if ok and (type(name) == "string" or type(name) == "number") then
                        name = tostring(name):match("^%s*(.-)%s*$")
                        if name ~= "" then
                            if (type(version) == "string" or type(version) == "number")
                                and tostring(version) ~= "" then
                                return name .. " " .. tostring(version)
                            end
                            return name
                        end
                    end
                end
            end
            for _, indicator in ipairs({
                { "KRNL_LOADED", "KRNL" }, { "OXYGEN_LOADED", "Oxygen U" },
                { "FLUXUS_LOADED", "Fluxus" }, { "fluxus", "Fluxus" },
                { "electron", "Electron" },
            }) do
                if scope[indicator[1]] then return indicator[2] end
            end
        end
        return "Unknown executor"
    end

    local function featureActive(options, id)
        local control = options[id]
        return type(control) == "table" and control.Value == true
    end

    local function instantTargetKind(model)
        local name = string.lower(model.Name)
        local parentName = model.Parent and string.lower(model.Parent.Name) or ""
        -- NPC types may be stored on the spawn folder rather than the model.
        if name == "berg" or parentName == "berg"
            or name:find("yeti boss", 1, true) or parentName:find("yeti boss", 1, true) then
            return nil
        end
        local names = name .. " " .. parentName
        local yetiMinion = names:find("snow fiend", 1, true)
            or names:find("frost minion", 1, true)
            or names:find("ice fiend", 1, true)
            or (names:find("minion", 1, true) and names:find("yeti", 1, true))
        if yetiMinion then return "Yeti" end
        if names:find("yeti", 1, true) then return nil end
        if names:find("cache", 1, true) or names:find("chest", 1, true)
            or names:find("lancer", 1, true) or names:find("prowler", 1, true)
            or names:find("captain", 1, true) or names:find("guard", 1, true) then
            return "Chest"
        end
        return "Normal"
    end

    function interface:IsInstantKillPremium()
        -- Match the supplied hub's entitlement gate. getgenv is test-only.
        return Premiums == true
    end

    function interface:CanInstantKillTarget(model)
        return self:IsInstantKillPremium() and typeof(model) == "Instance"
            and model:IsA("Model") and model.Parent ~= nil
            and players:GetPlayerFromCharacter(model) == nil
            and instantTargetKind(model) ~= nil
    end

    function interface:RequireInstantKillPremium(id, enabled)
        if not enabled or self:IsInstantKillPremium() then return true end
        local control = self.Options[id]
        if control then control:SetValue(false) end
        self:Notify({ Description = "Instant Kill requires Premium.", Type = "Warning" })
        return false
    end

    function interface:MarkCombatTarget(model)
        if not featureActive(self.Options, "InstantKillNormal") then return end
        if not self:CanInstantKillTarget(model) then return end
        if instantTargetKind(model) == "Normal" then
            self.AttackTargets[model] = os.clock() + 1.5
        end
    end

    local function finishInstantTarget(model, playerRoot, ownsPart, threshold)
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if not humanoid or not root or humanoid.Health <= 0 or humanoid.MaxHealth <= 0
            or (root.Position - playerRoot.Position).Magnitude > 100
            or humanoid.Health / humanoid.MaxHealth * 100 > threshold then return end
        local owned = false
        if type(ownsPart) == "function" then
            local ok, result = pcall(ownsPart, root)
            owned = ok and result == true
        end
        if owned then
            local ok = pcall(function() humanoid.Health = 0 end)
            if ok and humanoid.Health <= 0 then return end
        end
        -- Match the working reference: continue attacking when ownership is unavailable.
        return root
    end

    function interface:ScanInstantKill()
        if not self:IsInstantKillPremium() then return end
        local normal = featureActive(self.Options, "InstantKillNormal")
        local chest = featureActive(self.Options, "InstantKillChest")
        local yeti = featureActive(self.Options, "InstantKillYetiMinions")
        if not normal and not chest and not yeti then return end
        local ownsPart = isnetworkowner
        if type(ownsPart) ~= "function" then
            pcall(function()
                if type(getgenv) == "function" then ownsPart = getgenv().isnetworkowner end
            end)
        end
        local player = players.LocalPlayer
        local character = player and player.Character
        local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
        if not playerRoot then return end

        local now = os.clock()
        local normalThreshold = math.clamp(tonumber(self.Options.InstantKillNormalPercent
            and self.Options.InstantKillNormalPercent.Value) or 90, 1, 100)
        local visited = {}
        local nearestTarget, nearestDistance
        local function consider(model)
            if visited[model] or not self:CanInstantKillTarget(model) then return end
            visited[model] = true
            local kind = instantTargetKind(model)
            local threshold
            if kind == "Normal" and normal then threshold = normalThreshold
            elseif (kind == "Chest" and chest) or (kind == "Yeti" and yeti) then threshold = 90
            else return end
            local root = finishInstantTarget(model, playerRoot, ownsPart, threshold)
            if root then
                local distance = (root.Position - playerRoot.Position).Magnitude
                if not nearestDistance or distance < nearestDistance then
                    nearestTarget, nearestDistance = model, distance
                end
            end
        end
        for model, expiresAt in pairs(self.AttackTargets) do
            if not normal or not model.Parent or expiresAt < now then
                self.AttackTargets[model] = nil
            else
                consider(model)
            end
        end
        local humanoids = workspace:FindFirstChild("Humanoids")
        local regions = humanoids and humanoids:FindFirstChild("Regions")
        if regions then
            for _, region in ipairs(regions:GetChildren()) do
                local active = region:FindFirstChild("ActiveNpcs") or region
                for _, model in ipairs(active:GetDescendants()) do consider(model) end
            end
        end
        -- The supplied reference also finds Yeti minions in these containers.
        for _, containerName in ipairs({ "Mobs", "Debree" }) do
            local container = workspace:FindFirstChild(containerName)
            if container then
                for _, model in ipairs(container:GetDescendants()) do consider(model) end
            end
        end
        for _, model in ipairs(workspace:GetChildren()) do
            if model:IsA("Model") then consider(model) end
        end
        -- Native combat is shared by all NPCs; send at most one fallback attack per tick.
        if nearestTarget and type(self.InstantAttack) == "function" then
            self.InstantAttack(nearestTarget)
        end
    end

    local theme = {
        Accent = Color3.fromRGB(255, 193, 7),
        Accent2 = Color3.fromRGB(255, 224, 115),
        Accent3 = Color3.fromRGB(184, 126, 0),
        Background = Color3.fromRGB(10, 10, 12),
        Surface = Color3.fromRGB(17, 17, 19),
        Surface2 = Color3.fromRGB(24, 24, 27),
        Element = Color3.fromRGB(30, 29, 28),
        Border = Color3.fromRGB(58, 59, 67),
    }
    interface.Theme = theme

    local categoryInfo = {
        FARM = { "Farm", "Automated farming and loot", "target" },
        QUESTS = { "Quests", "Leveling and progression", "list" },
        OUWIGAHARA = { "Ouwigahara", "Dungeon and crafting", "sword" },
        COMBAT = { "Combat", "Combat and survival", "combat" },
        EXTRAS = { "Extras", "Fishing, clan and horse", "star" },
        PLAYER = { "Player", "Movement and character", "player" },
        VISUALS = { "Visuals", "ESP, camera and world", "eye" },
        NAVIGATION = { "Travel", "Teleports and attach", "move" },
        SERVER = { "Server", "Server, alerts and events", "server" },
