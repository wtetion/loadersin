        management:AddButton({ Name = "Copy Job ID to Clipboard", Icon = "copy", Callback = function()
            local id = tostring(game.JobId or "")
            raw:Notify("Server ID", id ~= "" and copyText(id) and "Job ID copied to clipboard."
                or "Job ID unavailable to copy.", id ~= "" and "Info" or "Error")
        end })

        local guiControls = home:AddSection({
            Name = "GUI Controls", Description = "Hide or close the interface.",
            Side = "Left", Pill = "Overview",
        })
        guiControls:AddButton({ Name = "Hide Axel Hub", Icon = "eye", Callback = function()
            raw:SetOpen(false)
        end })
        guiControls:AddButton({ Name = "Close Axel Hub", Icon = "power", Callback = function()
            raw:ConfirmUnload()
        end })

        local originalRawUnload = raw.Unload
        local window = setmetatable({
            Raw = raw, Home = home, Adapter = self, RawUnload = originalRawUnload,
        }, { __index = windowMethods })
        raw.Unload = function() window:Unload() end
        self.Wrapper = window

        local refreshElapsed = 0
        self.DashboardConnection = runService.Heartbeat:Connect(function(delta)
            refreshElapsed += delta
            if refreshElapsed < 0.75 or raw._destroyed or raw.ActiveTab ~= home then return end
            refreshElapsed = 0
            local playerCount = #players:GetPlayers()
            local maxPlayers
            pcall(function() maxPlayers = players.MaxPlayers end)
            metrics:Set("FPS", tostring(raw.FpsValue and raw.FpsValue.Text or "--") .. " FPS", raw.Theme.Accent2)
            metrics:Set("Ping", player and pingText(player) or "-- ms", raw.Theme.Accent2)
            metrics:Set("Uptime", elapsedText(os.clock() - startedAt), raw.Theme.Accent2)
            metrics:Set("Users", tostring(playerCount) ..
                (tonumber(maxPlayers) and maxPlayers > 0 and ("/" .. tostring(maxPlayers)) or ""),
                raw.Theme.Accent2)
            local detectedExecutor = executorName()
            if detectedExecutor ~= currentExecutorName then
                currentExecutorName = detectedExecutor
                executorStatus:Set(detectedExecutor, raw.Theme.Accent2, nil, detectedExecutor)
            end
            local enabled, total = 0, 0
            for _, control in pairs(self.Options) do
                if control.Type == "Toggle" then
                    total += 1
                    if control.Value == true then enabled += 1 end
                end
            end
            activeFeatures:Set(tostring(enabled) .. " / " .. tostring(total), raw.Theme.Accent2)
            for id, row in pairs(featureRows) do
                local on = featureActive(self.Options, id)
                row:Set(on and "Enabled" or "Disabled", on and raw.Theme.Success or raw.Theme.Muted)
            end
        end)

        return window
    end

    function interface:CreateSettingsTab(window)
        local tab = window.Raw:AddTab({ Name = "Settings", Subtitle = "Configuration and cleanup", Icon = "settings" })
        self.SettingsTab = tab
        window.Home:AddPill({ Name = "Settings", TargetTab = tab })
        local section = tab:AddSection({ Name = "Configuration", Side = "Left" })
        local configName = "ProjectSlayers2"
        section:AddInput({ Name = "Config name", Default = configName, Callback = function(value)
            if value and value ~= "" then configName = tostring(value) end
        end })
        section:AddButton({ Name = "Save config", Icon = "download", Callback = function()
            local ok, reason = window.Raw:SaveConfig(configName)
            window.Raw:Notify("Settings", ok and "Config saved" or tostring(reason), ok and "Success" or "Error")
        end })
        section:AddButton({ Name = "Load config", Icon = "upload", Callback = function()
            local ok, reason = window.Raw:LoadConfig(configName)
            window.Raw:Notify("Settings", ok and "Config loaded" or tostring(reason), ok and "Success" or "Error")
        end })
        section:AddButton({ Name = "Unload Axel Hub", Icon = "power", Callback = function()
            window:Unload()
        end })

        return tab
    end

    function interface:Notify(details)
        if activeWindow then
            activeWindow:Notify("Axel Hub", details.Description or details.Title or "", details.Type or "Info")
        end
    end
    return interface
end

