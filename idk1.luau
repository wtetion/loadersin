    local function asList(values)
        if type(values) ~= "table" then
            return values == nil and {} or { values }
        end
        local result = {}
        for _, value in ipairs(values) do
            if value ~= nil then table.insert(result, value) end
        end
        if #result == 0 then
            for key, enabled in pairs(values) do
                if type(key) == "string" and enabled then table.insert(result, key) end
            end
            table.sort(result)
        end
        return result
    end

    local function asMap(values)
        local selected = {}
        for _, value in ipairs(asList(values)) do selected[value] = true end
        return selected
    end

    local function bridgeControl(section, kind, id, options)
        options = options or {}
        local callback = options.Callback
        local multi = kind == "Dropdown" and options.Multi == true
        local initial = options.Default
        if multi then initial = asMap(initial) end

        local control = {
            Type = multi and "Dropdown" or kind,
            Value = initial,
            Values = options.Values,
            Callback = callback,
        }
        local function update(value)
            control.Value = multi and asMap(value) or value
            if type(callback) == "function" then
                callback(control.Value)
            end
        end

        local data = {
            Name = options.Text or tostring(id),
            Description = options.Description,
            Default = multi and asList(options.Default) or initial,
            Min = options.Min,
            Max = options.Max,
            Decimals = options.Rounding,
            Suffix = options.Suffix,
            Options = asList(options.Values),
            Placeholder = options.Placeholder,
            Flag = tostring(id),
            Callback = update,
        }

        local method = multi and "AddMultiDropdown" or "Add" .. kind
        local raw = section[method](section, data)
        control.Holder = raw.Row

        function control:SetValue(value)
            local display = multi and asList(value) or value
            self.Value = multi and asMap(value) or value
            raw:Set(display, true)
            if type(self.Callback) == "function" then
                task.spawn(self.Callback, self.Value)
            end
        end

        function control:SetValues(values)
            self.Values = asList(values)
            if type(raw.SetOptions) == "function" then
                raw:SetOptions(self.Values)
                if multi then
                    self.Value = asMap(raw:Get())
                else
                    self.Value = raw:Get()
                end
            end
        end

        function control:AddKeybind(keyOptions)
            keyOptions = keyOptions or {}
            local key = keyOptions.Default or Enum.KeyCode.Unknown
            return section:AddKeybind({
                Name = data.Name .. " key",
                Default = key,
                OnPress = function()
                    self:SetValue(not self.Value)
                end,
            })
        end

        interface.Options[id] = control
        interface.Flags[id] = control
        return control
    end

    local groupMethods = {}
    for _, method in ipairs({ "Toggle", "Slider", "Dropdown", "ColorPicker", "Input" }) do
        local controlKind = method
        groupMethods["Add" .. method] = function(self, id, options)
            return bridgeControl(self.Section, controlKind, id, options)
        end
    end
    function groupMethods:AddButton(options)
        options = options or {}
        return self.Section:AddButton({
            Name = options.Text or options.Name or "Run",
            Description = options.Description,
            Callback = options.Func or options.Callback,
            Icon = options.Icon or "check",
        })
    end
    function groupMethods:AddLabel(value)
        return self.Section:AddLabel({ Name = tostring(value) })
    end

    local tabMethods = {}
    function tabMethods:AddGroupbox(name)
        local section = AxelUI.TabMethods.AddSection(self.SubTab, {
            Name = tostring(name),
            Side = "Auto",
        })
        return setmetatable({ Section = section }, { __index = groupMethods })
    end
    function tabMethods:Select()
        self.Window:SelectTab(self.Parent)
        self.Parent:SelectSubTab(self.SubTab)
    end

    local categoryMethods = {}
    function categoryMethods:AddTab(name)
        local subTab = self.Tab:AddSubTab({ Name = tostring(name), NoDefaultCard = true })
        local wrapper = setmetatable({ Parent = self.Tab, SubTab = subTab, Window = self.Window },
            { __index = tabMethods })
        if self.CategoryName == "FARM" and name == "Mob Farm" then
            self.Adapter:InstallInstantKillControls(wrapper)
        end
        return wrapper
    end

    local windowMethods = {}
    function windowMethods:AddCategory(name)
        local descriptor = categoryInfo[name] or { tostring(name), "", "grid" }
        local tab = self.Raw:AddTab({
            Name = descriptor[1], Subtitle = descriptor[2], Icon = descriptor[3],
        })
        self.Home:AddPill({ Name = descriptor[1], TargetTab = tab })
        return setmetatable({ Tab = tab, Window = self.Raw, Adapter = self.Adapter,
            CategoryName = name }, { __index = categoryMethods })
    end
    function windowMethods:SelectHome()
        self.Raw:SelectTab(self.Home)
    end
    function windowMethods:Unload()
        if self.Adapter.DashboardConnection then
            self.Adapter.DashboardConnection:Disconnect()
            self.Adapter.DashboardConnection = nil
        end
        if self.Adapter.InstantKillConnection then
            self.Adapter.InstantKillConnection:Disconnect()
            self.Adapter.InstantKillConnection = nil
        end
        self.RawUnload(self.Raw)
    end

    function interface:InstallInstantKillControls(mobFarm)
        local controls = mobFarm:AddGroupbox("Instant Kill (Premium)")
        controls:AddToggle("InstantKillNormal", {
            Text = "Instant Kill (Normal)",
            Description = "Normal NPCs at the selected HP; chest/yeti minions use their own toggles.",
            Default = false,
            Callback = function(value) self:RequireInstantKillPremium("InstantKillNormal", value) end,
        })
        controls:AddSlider("InstantKillNormalPercent", {
            Text = "Normal HP Threshold", Min = 1, Max = 100, Default = 90,
            Rounding = 0, Suffix = "%",
        })
        controls:AddToggle("InstantKillChest", {
            Text = "Instant Kill Chest Minions (90%)",
            Description = "Chest and cache guards at or below 90% HP.",
            Default = false,
            Callback = function(value) self:RequireInstantKillPremium("InstantKillChest", value) end,
        })
        controls:AddToggle("InstantKillYetiMinions", {
            Text = "Instant Kill Yeti Minions (90%)",
            Description = "Yeti minions at or below 90% HP; excludes the boss.",
            Default = false,
            Callback = function(value) self:RequireInstantKillPremium("InstantKillYetiMinions", value) end,
        })
        local elapsed = 0
        self.InstantKillConnection = runService.Heartbeat:Connect(function(delta)
            if not self.Window or self.Window._destroyed then return end
            elapsed += delta
            if elapsed < 0.12 then return end
            elapsed = 0
            local ok, reason = pcall(function() self:ScanInstantKill() end)
            if not ok then warn("[Axel Hub Instant Kill] " .. tostring(reason)) end
        end)
    end

